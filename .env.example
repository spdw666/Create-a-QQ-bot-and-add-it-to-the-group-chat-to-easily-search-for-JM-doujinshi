# JM娘 环境变量示例 · Environment variable template
# 复制为 .env 或通过 systemd 的 Environment= 注入（详见 README「配置」章节）。
# Copy to .env, or inject via systemd Environment= (see README "Configuration").

# 【必填 Required】上传 ZIP 的 AES 密码（需告知解压用户）
# AES password for uploaded ZIPs (share it with users)
JM_ZIP_PASSWORD=CHANGE_ME

# 【必填 Required】服务器公网 IP / 域名，用于生成浏览器下载链接
# Public IP/host of this server, used to build browser download links
JM_PUBLIC_IP=127.0.0.1

# 【可选 Optional】jmcomic 访问代理（留空 = 直连；国内环境可用如 http://127.0.0.1:7890）
# HTTP proxy for jmcomic (empty = direct)
JM_PROXY=

# 【可选 Optional】SauceNAO 识图 API key（免费注册 https://saucenao.com/user.php；未填时以图搜本仅用 iQDB 兜底）
# SauceNAO API key for reverse image search (free; without it only iQDB is used)
JM_SAUCENAO_KEY=

# 【可选 Optional】视觉大模型 API key（SiliconFlow，免费注册 https://siliconflow.cn；用于内页图 AI 识别）
# Vision LLM API key (SiliconFlow; used for inner-page AI recognition)
JM_LLM_KEY=
# 识图视觉模型（可选；默认 Qwen/Qwen3-VL-8B-Instruct 免费档；付费可用 Qwen/Qwen3-VL-30B-A3B-Instruct）
JM_LLM_MODEL=
# AgentKey API key（ascii2d 识图直连被反爬时的 Firecrawl 浏览器渲染中转；https://console.agentkey.app/ 获取）
JM_AGENTKEY_KEY=
# 新识图源开关：置 1 启用 ascii2d（直连失败自动走 AgentKey 中转）/Yandex
JM_NEW_IMAGE_SOURCES=

# 【可选 Optional】Google Cloud Vision API key（Web Detection 识图；每月前 1000 次免费，
# 但免费档需绑定海外信用卡启用 billing；未填时该层自动跳过）
# Google Vision API key (1,000 free calls/month; requires an international credit card
# to enable billing even for the free tier; skipped if empty)
JM_GOOGLE_KEY=

# 【可选 Optional】E-Hentai 登录 cookie（以图搜本；登录 e-hentai.org 后 F12 控制台执行
# document.cookie 复制整串；未填时 EH 识图层跳过）
# E-Hentai login cookie for reverse image search (login then run document.cookie in F12 console)
JM_EH_COOKIES=

# 【可选 Optional】单个可独立解压 ZIP 分卷的最大字节数；默认 900MiB，设 0 关闭自动分卷
# Maximum size of each independently extractable ZIP part; default 900MiB, 0 disables splitting
JM_MAX_ZIP_PART_BYTES=943718400

# 【可选 Optional】管理员 QQ 号，英文逗号分隔；不填则管理命令无人可用（安全默认）
# Administrator QQ IDs, comma-separated; empty means no administrator commands are enabled
JM_ADMIN_USERS=

# 【可选 Optional】订阅后台检查间隔秒数；默认 3600，摘要仍按个人日报/周报节奏发送
# Subscription polling interval in seconds; default 3600; delivery still follows each user's cadence
JM_SUBSCRIPTION_CHECK_SECONDS=3600
